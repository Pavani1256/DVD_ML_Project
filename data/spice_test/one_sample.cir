
* One-sample transistor simulation

.include "C:/Users/hp/Desktop/DVD_project/data/spice_test/sample_model.pm"

.options gmin=1e-18 abstol=1e-18 reltol=1e-6 vntol=1e-9

.temp 1.51588066658

VDS d 0 DC 0.756101312346
VGS g 0 DC 0.949676487799
VSS s 0 DC 0.200312041612
VBS b 0 DC 0.949676487799

M1 d g s b pmos L=1.6e-08 W=1.05998563191e-07

.control
op

let Id = -i(VDS)
let Ig = -i(VGS)
let Is = -i(VSS)
let Ib = -i(VBS)

print Id
print Ig
print Is
print Ib

quit
.endc

.end
