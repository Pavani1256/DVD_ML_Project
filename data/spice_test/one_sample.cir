
* One-sample transistor simulation

.include "C:/Users/sannjana punna/DVD_ML_Project/data/spice_test/sample_model.pm"

.options gmin=1e-18 abstol=1e-18 reltol=1e-6 vntol=1e-9

.temp 39.6015369311

VDS d 0 DC 0.128115693723
VGS g 0 DC 0
VSS s 0 DC 0.505440843953
VBS b 0 DC 0

M1 d g s b nmos L=1.6e-08 W=3.73296769012e-08

.control
op

let Id = -i(VDS)
let Ig = -i(VGS)
let Is = -i(VSS)
let Ib = -i(VBS)

print Id
print Ig
print Is
print Ib

quit
.endc

.end
