# ---- Python ----
__pycache__/
*.pyc
.ipynb_checkpoints/

# ---- Virtual environments ----
.venv/
.venv-*/
venv/

# ---- Data ----
data/raw/*.csv
# data/processed/*.csv is NOT ignored: the four datasets are deliverable 1,
# and train_models.py needs data/processed/*_edge.csv too.

# ---- ngspice scratch / work folders (regenerated by the scripts) ----
# run_dataset.py per-worker scratch
data/spice_work/
# run_one_sample.py output (contains absolute local paths)
data/spice_test/
# gate_validation.py: 3,600 temporary .pm/.cir files
data/gate_validation/
# circuit_validation.py: resume cache + netlists of failed runs
data/circuit_validation/
*.raw
*.tmp
*.log

# ---- Archives and local copies ----
*.zip
*copy/

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# saved_models/*.joblib are committed through Git LFS (see .gitattributes),
# not ignored: they are a required deliverable (pmos_off.joblib is 265 MB).
# results/ is committed: deliverable tables/plots and the --reuse-spice caches.
